{
  "name": "vulnscan",
  "version": "1.0.0",
  "description": "Standalone security vulnerability scanner for source code",
  "main": "dist/index.js",
  "bin": {
    "vulnscan": "./dist/index.js",
    "vulnscan-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-timeout=120000 \"test/*.test.js\"",
    "test:only": "node --test --test-timeout=120000 \"test/*.test.js\"",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp/server.js",
    "dev": "npx ts-node src/index.ts"
  },
  "keywords": [
    "security",
    "vulnerability",
    "scanner",
    "sast",
    "static-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^4.1.2",
    "tree-sitter": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "chokidar": "^4.0.3"
  }
}
